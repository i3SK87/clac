{
  "manifest_version": 3,
  "name": "CLAC",
  "version": "1.5.0",
  "description": "Rellena contraseñas desde CLAC, el gestor de contraseñas de este ordenador. Sin nube: solo habla con CLAC.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CLAC (Ctrl+Mayús+X)",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png",
      "48": "iconos/48.png"
    }
  },
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Abrir CLAC"
    }
  },
  "minimum_chrome_version": "120"
}
