{
  "name": "clac",
  "productName": "CLAC",
  "version": "1.3.0",
  "description": "Gestor de contraseñas local para Windows",
  "author": "okli2",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extension.json",
    "build": "npm run typecheck && electron-vite build && npm run extension",
    "test": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=out/test/smoke.mjs --external:node:* --alias:@shared=./src/shared && node out/test/smoke.mjs",
    "icono": "node ../casa/marca/marca.mjs clac resources",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "pack": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "extension": "node scripts/extension.mjs",
    "capturas": "node docs/tutorial/capturar.mjs",
    "tutorial": "electron docs/tutorial/construir.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "casa": "file:../casa",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@43.4.1": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
